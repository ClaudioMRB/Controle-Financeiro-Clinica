{
  "name": "controle-financeiro-clinica",
  "version": "1.0.1",
  "description": "Aplicativo de controle financeiro para clínica médica",
  "author": "Seu Nome",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron-build": "electron-builder --win",
    "web:build": "node scripts/copy-web-assets.js",
    "android:setup": "npm run web:build && cap add android",
    "android:sync": "npm run web:build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.js"
  },
  "build": {
    "appId": "com.controlefinanceiro.clinica",
    "productName": "Controle Financeiro Clinica",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Controle Financeiro Clínica"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.116.0"
  }
}
